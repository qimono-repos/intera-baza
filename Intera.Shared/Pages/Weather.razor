@page "/weather"
@using Intera.Shared.Services
@inject IFormFactor FormFactor

@{
/*

<ComponentSearch OnSearch="OnSearch"/>

*/
}


<p> Qimono <em>@factor</em> (Platform: <em>@platform</em>) </p>

